{
    "name": "vsitchikhin/abelohost-test",
    "description": "Test task blog implementation using pure PHP, Smarty, and MySQL",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "smarty/smarty": "^4.3",
        "vlucas/phpdotenv": "^5.6",
        "fakerphp/faker": "^1.23",
        "bramus/router": "^1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.9",
        "captainhook/captainhook": "^5.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "captainhook/captainhook": true
        }
    }
}
