{
    "config": {
        "verbosity": "normal"
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "composer check"
            }
        ]
    },
    "pre-push": {
        "enabled": true,
        "actions": [
            {
                "action": "npm run lint"
            },
            {
                "action": "npm run test:e2e"
            }
        ]
    }
}
